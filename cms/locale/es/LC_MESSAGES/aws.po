msgstr "Solo los archivos, sin la base de datos (<code>-f</code>; no se puede reimportar)"

msgid "Options"
msgstr "Opciones"

msgid "Do not export what can be regenerated: results and executables (<code>-G</code>, recommended)"
msgstr "No exportar lo que se puede regenerar: resultados y ejecutables (<code>-G</code>, recomendado)"

msgid "Do not export the submissions (<code>-S</code>)"
msgstr "No exportar los envíos (<code>-S</code>)"

msgid "Do not export the user tests (<code>-U</code>)"
msgstr "No exportar las pruebas de usuario (<code>-U</code>)"

msgid "Do not export the users (<code>-X</code>)"
msgstr "No exportar los usuarios (<code>-X</code>)"

msgid "There are contests running or in analysis mode. The dump is read without freezing the database: it may come out inconsistent, and the queries and the reading of files load the database that the contest uses."
msgstr "Hay concursos en curso o en modo de análisis. El volcado se lee sin congelar la base de datos: puede salir inconsistente, y las consultas y la lectura de archivos cargan la base de datos que usa el concurso."

msgid "I understand the risk and want to export anyway"
msgstr "Entiendo el riesgo y quiero exportar de todos modos"

