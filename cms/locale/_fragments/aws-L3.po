msgstr "No hay datasets para este problema."

#, python-format
msgid "Current dataset: \"<strong>%(description)s</strong>\"."
msgstr "Dataset actual: «<strong>%(description)s</strong>»."

msgid ""
"Click on one of the following items to view the results under a different"
" dataset."
msgstr ""
"Haz clic en uno de los elementos siguientes para ver los resultados con "
"otro dataset."

#, python-format
