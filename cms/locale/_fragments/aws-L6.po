# Spanish translations of the new messages of lane L6 (participations, contest tasks, activity, ranking).
msgid ""
msgstr ""
"Language: es\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Tasks list of <a href=\"%(contest_url)s\">%(contest_name)s</a>"
msgstr "Lista de problemas de <a href=\"%(contest_url)s\">%(contest_name)s</a>"

msgid "Add a new task:"
msgstr "Agrega un problema nuevo:"

msgid "Select a new task"
msgstr "Elige un problema nuevo"

msgid "Add task"
msgstr "Agregar problema"

msgid "Remove selected task from the contest:"
msgstr "Quitar el problema seleccionado del concurso:"

msgid "Remove from contest"
msgstr "Quitar del concurso"

msgid "Move selected task:"
msgstr "Mover el problema seleccionado:"

msgid "to the top"
msgstr "al principio"

msgid "up by 1"
msgstr "subir 1"

msgid "down by 1"
msgstr "bajar 1"

msgid "to the bottom"
msgstr "al final"

msgid "Please select a valid task"
msgstr "Selecciona un problema válido"

msgid "Please select a valid user"
msgstr "Selecciona un usuario válido"

msgid "Please select a valid group"
msgstr "Selecciona un grupo válido"

msgid "Team with code '%s' does not exist"
msgstr "No existe un equipo con el código '%s'"

msgid "Add a new user:"
msgstr "Agrega un usuario nuevo:"

msgid "Select a new user"
msgstr "Elige un usuario nuevo"

msgid "Add user"
msgstr "Agregar usuario"

msgid "Remove Participation"
msgstr "Quitar participación"

msgid "Are you sure you want to remove user %(username)s from contest %(contest_name)s, including all related data?"
msgstr "¿Seguro que quieres quitar al usuario %(username)s del concurso %(contest_name)s, incluidos todos sus datos relacionados?"

msgid "You do not have permission to remove a participation."
msgstr "No tienes permiso para quitar una participación."

msgid "Times are in the contest's timezone (%(timezone)s)."
msgstr "Las horas están en la zona horaria del concurso (%(timezone)s)."

msgid "Simultaneous activity (%(count)s)"
msgstr "Actividad simultánea (%(count)s)"

msgid "The same participation active from two devices (or, without a device, from two IP addresses) at the same time for more than %(seconds)s seconds. A dynamic IP change on one device is not reported. A missing device is not evidence of an API script: a browser that did not present the device cookie (the first request after an IP autologin, cleared cookies, a cookie-less client) has none either."
msgstr "La misma participación activa desde dos dispositivos (o, sin dispositivo, desde dos direcciones IP) al mismo tiempo durante más de %(seconds)s segundos. No se reporta el cambio de IP dinámica en un dispositivo. La falta de dispositivo no prueba que sea un script de API: un navegador que no presentó la cookie del dispositivo (la primera solicitud tras un autologin por IP, cookies borradas, un cliente sin cookies) tampoco lo tiene."

msgid "<strong>Only the %(count)s most recent are shown</strong> (and highlighted in the intervals below). Each participation's page shows all of its own, and the csv below has every interval."
msgstr "<strong>Solo se muestran los %(count)s más recientes</strong> (y se resaltan en los intervalos de abajo). La página de cada participación muestra todos los suyos, y el csv de abajo incluye cada intervalo."

msgid "More than one device (%(count)s)"
msgstr "Más de un dispositivo (%(count)s)"

msgid "Informational only: another browser, a private window or cleared cookies also count as a new device."
msgstr "Solo informativo: otro navegador, una ventana privada o las cookies borradas también cuentan como un dispositivo nuevo."

msgid "Devices"
msgstr "Dispositivos"

msgid "None."
msgstr "Ninguno."

msgid "Intervals (%(count)s)"
msgstr "Intervalos (%(count)s)"

msgid "Username:"
msgstr "Usuario:"

msgid "IP address or network:"
msgstr "Dirección IP o red:"

msgid "Filter"
msgstr "Filtrar"

msgid "Clear"
msgstr "Limpiar"

msgid "Download as <a href=\"%(csv_url)s\">csv</a> (with the filters above; times in UTC)."
msgstr "Descarga en <a href=\"%(csv_url)s\">csv</a> (con los filtros de arriba; horas en UTC)."

msgid "No device: an API client, or a browser that did not present the device cookie"
msgstr "Sin dispositivo: un cliente de API, o un navegador que no presentó la cookie del dispositivo"

msgid "Device"
msgstr "Dispositivo"

msgid "IP address"
msgstr "Dirección IP"

msgid "Start"
msgstr "Inicio"

msgid "Last activity"
msgstr "Última actividad"

msgid "End"
msgstr "Fin"

msgid "Started by"
msgstr "Iniciado por"

msgid "No activity recorded."
msgstr "No hay actividad registrada."

msgid "First device / IP"
msgstr "Primer dispositivo / IP"

msgid "Second device / IP"
msgstr "Segundo dispositivo / IP"

msgid "Overlap from"
msgstr "Coincidencia desde"

msgid "Overlap to"
msgstr "Coincidencia hasta"

msgid "Download as <a href=\"%(csv_url)s\">csv</a>, <a href=\"%(text_url)s\">text</a>."
msgstr "Descarga en <a href=\"%(csv_url)s\">csv</a>, <a href=\"%(text_url)s\">texto</a>."

msgid "Team"
msgstr "Equipo"

msgid "Global"
msgstr "Total"

msgid "Participation of <a href=\"%(user_url)s\">%(username)s</a> in <a href=\"%(contest_url)s\">%(contest_name)s</a>"
msgstr "Participación de <a href=\"%(user_url)s\">%(username)s</a> en <a href=\"%(contest_url)s\">%(contest_name)s</a>"

msgid "Reevaluate all %(count)s submissions for this user in this contest (for all datasets)"
msgstr "Reevaluar todos los envíos de este usuario en este concurso (%(count)s en total, para todos los datasets)"

msgid "Participation information"
msgstr "Información de la participación"

msgid "The group this contestant is part of. This determines the time window for participation."
msgstr "El grupo al que pertenece el concursante. Determina la ventana de tiempo de la participación."

msgid "Code of the team of the contestant in this contest. Only used in the external ranking."
msgstr "Código del equipo del concursante en este concurso. Solo se usa en el ranking externo."

msgid "Contestant password for this contest. If empty, the contestant's main password is used.\n                                     Caution: stored in plain text."
msgstr "Contraseña del concursante para este concurso. Si está vacía, se usa la contraseña principal del concursante. Atención: se guarda en texto plano."

msgid "Whether the contestant's results will be visible in the external ranking."
msgstr "Si los resultados del concursante serán visibles en el ranking externo."

msgid "Hidden participation"
msgstr "Participación oculta"

msgid "Whether the contestant is unrestricted by maximum number of submissions, user tests,\n                                    and minimum interval between submissions, user tests, and contest time."
msgstr "Si el concursante queda libre del número máximo de envíos y de user tests, del intervalo mínimo entre envíos y entre user tests, y del tiempo del concurso."

msgid "Unrestricted participation"
msgstr "Participación sin restricciones"

msgid "A comma-separated list of IP addresses (or subnets) of the contestant for this contest.\n                                    Used for IP-based login restrictions and/or for autologin (in this case, it must be a single address)."
msgstr "Lista separada por comas de las direcciones IP (o subredes) del concursante para este concurso. Se usa para las restricciones de inicio de sesión por IP o para el autologin (en ese caso, debe ser una sola dirección)."

msgid "IP address or subnet"
msgstr "Dirección IP o subred"

msgid "Time of first login during this contest, used for USACO-style contests.\n                                    Example: '2015-12-31 15:00:00'."
msgstr "Hora del primer inicio de sesión en este concurso, usada en concursos al estilo USACO. Ejemplo: '2015-12-31 15:00:00'."

msgid "Time of first login (in UTC)"
msgstr "Hora del primer inicio de sesión (en UTC)"

msgid "To be set (in seconds) to acknowledge that the contestant lost that amount of time at the beginning of the contest.\n                                    If this is non-zero, all the events (token generation, end of contest) for this contestant will be shifted of the appropriate amount."
msgstr "Se define (en segundos) para reconocer que el concursante perdió esa cantidad de tiempo al inicio del concurso. Si no es cero, todos los eventos (generación de tokens, fin del concurso) de este concursante se desplazarán en la cantidad correspondiente."

msgid "Delay"
msgstr "Retraso"

msgid "To be set (in seconds) to acknowledge that the contestant lost that amount of time during the contest.\n                                    If this is non-zero, the end of the contest will be shifted of the appropriate amount for this contestant."
msgstr "Se define (en segundos) para reconocer que el concursante perdió esa cantidad de tiempo durante el concurso. Si no es cero, el fin del concurso se desplazará en la cantidad correspondiente para este concursante."

msgid "Extra time"
msgstr "Tiempo extra"

msgid "The whole contest's log is under <a href=\"%(activity_url)s\">Activity</a>."
msgstr "El registro completo del concurso está en <a href=\"%(activity_url)s\">Actividad</a>."

msgid "<strong>Simultaneous activity</strong> (its intervals are highlighted below):"
msgstr "<strong>Actividad simultánea</strong> (sus intervalos están resaltados abajo):"

msgid "No questions."
msgstr "No hay preguntas."

msgid "Messages"
msgstr "Mensajes"

msgid "Subject:"
msgstr "Asunto:"

msgid "Text:"
msgstr "Texto:"

msgid "Send"
msgstr "Enviar"

msgid "By: %(admin_name)s"
msgstr "Por: %(admin_name)s"

msgid "No messages."
msgstr "No hay mensajes."

msgid "<unknown>"
msgstr "<unknown>"
