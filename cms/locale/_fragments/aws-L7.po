msgid "New admin"
msgstr "Nuevo admin"

msgid "Admin information"
msgstr "Información del admin"

msgid "Create"
msgstr "Crear"

msgid "Enabled"
msgstr "Activado"

msgid "Leaving the password field empty will keep the previous password."
msgstr "Si dejas vacío el campo de contraseña, se conserva la contraseña anterior."

msgid "Delete this admin"
msgstr "Borrar este admin"

msgid "Admins list"
msgstr "Lista de admins"

msgid "All permissions"
msgstr "Todos los permisos"

msgid "Messaging permissions"
msgstr "Permisos de mensajería"

msgid "Add a new admin"
msgstr "Agregar un admin nuevo"

msgid "Disabled admins cannot log in."
msgstr "Los admins desactivados no pueden iniciar sesión."

msgid ""
"Admins with the \"All permissions\" bit set can do any operation, "
"regardless of the status of the other permission bits."
msgstr ""
"Los admins con el permiso «Todos los permisos» activado pueden hacer "
"cualquier operación, sin importar el estado de los demás permisos."

msgid ""
"The \"Messaging\" permissions allow the admin to communicate with the "
"contestants, answering questions, sending private messages and "
"announcements."
msgstr ""
"Los permisos de «Mensajería» permiten que el admin se comunique con los "
"concursantes: responder preguntas, enviar mensajes privados y anuncios."

msgid "No admin name specified."
msgstr "No se indicó el nombre del admin."

msgid "Empty password not permitted."
msgstr "No se permite una contraseña vacía."

msgid "Remove ranking group"
msgstr "Borrar grupo de ranking"

#, python-format
msgid "Are you sure you want to remove ranking group %(name)s (%(description)s)?"
msgstr "¿Seguro que quieres borrar el grupo de ranking %(name)s (%(description)s)?"

#, python-format
msgid ""
"%(count)s contest(s) will no longer be sent to any ranking. The contests "
"themselves are not removed."
msgstr ""
"%(count)s concurso(s) dejarán de enviarse a cualquier ranking. Los "
"concursos en sí no se borran."

msgid "No contest is sent to this ranking."
msgstr "Ningún concurso se envía a este ranking."

msgid "Its scoreboard will be emptied."
msgstr "Su marcador se vaciará."

msgid "You do not have permission to remove a ranking group."
msgstr "No tienes permiso para borrar un grupo de ranking."

