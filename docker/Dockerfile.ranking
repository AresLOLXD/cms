# syntax=docker/dockerfile:1
ARG BASE_IMAGE=ubuntu:noble
FROM ${BASE_IMAGE}

# Only what cmsRankingWebServer needs: it imports no cms.* module and four
# third-party packages (gevent, werkzeug, bcrypt, pycryptodomex), all of which
# ship wheels, so there is no compiler or -dev package here.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked <<EOF
#!/bin/bash -ex
    export DEBIAN_FRONTEND=noninteractive
    rm -f /etc/apt/apt.conf.d/docker-clean
    apt-get update
    apt-get install -y \
        python3 \
        python3-venv
EOF

RUN useradd -ms /bin/bash -u 2000 cmsuser

USER cmsuser
ENV LANG=C.UTF-8

COPY --chown=cmsuser:cmsuser constraints.txt /home/cmsuser/constraints.txt

# The venv must be /home/cmsuser/cms: cmsranking/Config.py derives its config,
# lib and log directories from sys.prefix.
RUN --mount=type=cache,target=/home/cmsuser/.cache/pip,uid=2000 \
    python3 -m venv /home/cmsuser/cms && \
    /home/cmsuser/cms/bin/pip install --only-binary=:all: -c /home/cmsuser/constraints.txt \
        gevent werkzeug bcrypt pycryptodomex
ENV PATH="/home/cmsuser/cms/bin:$PATH"

# Created as cmsuser so the named volume mounted here inherits the ownership.
RUN mkdir -p /home/cmsuser/cms/lib/ranking

ENV PYTHONPATH=/home/cmsuser/app
COPY --chown=cmsuser:cmsuser cmscommon /home/cmsuser/app/cmscommon
COPY --chown=cmsuser:cmsuser cmsranking /home/cmsuser/app/cmsranking
COPY --chown=cmsuser:cmsuser --chmod=755 scripts/cmsRankingWebServer /home/cmsuser/cms/bin/cmsRankingWebServer

# Fails the build if the ranking starts importing a package that is not installed above.
RUN python3 -c "import cmsranking.RankingWebServer, cmsranking.seed"

COPY --chown=cmsuser:cmsuser docker/generate_config.py /home/cmsuser/generate_config.py
COPY --chown=cmsuser:cmsuser docker/entrypoint.sh /home/cmsuser/entrypoint.sh
RUN chmod +x /home/cmsuser/entrypoint.sh

ENTRYPOINT ["/home/cmsuser/entrypoint.sh"]
CMD ["cmsRankingWebServer"]

# At the end of the last stage, so a new commit does not invalidate the cache.
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA
